{
  "name": "bundled_rules/core",
  "rules": [
    {
      "sourceFilter": ["BepInEx"],
      "contentPattern": "loading \\[(?<name>.*) (?<version>[0-9\\.]*)\\]",
      "scoring": {
        "ignore": true
      },
      "transform": {
        "section": "Plugins/BepInEx",
        "rule": "table(name, version)"
      }
    },
    {
      "sourceFilter": ["BepInEx"],
      "contentPattern": "bepinex (?<bepinex_version>[0-9\\.]*) - (?<game>.*) \\((?:.*)\\)",
      "scoring": {
        "ignore": true
      },
      "transform": {
        "section": "Metadata",
        "rule": "set_fields"
      }
    },
    {
      "sourceFilter": ["Homebrewery"],
      "contentPattern": "Waking up at (?:\\S*) (?:\\S*) (?:AM|PM) UTC\\.\\.\\. Game Version is: (?<game_version>[\\S\\ ]*)",
      "scoring": {
        "ignore": true
      },
      "transform": {
        "section": "Metadata",
        "rule": "set_fields"
      }
    }
  ]
}