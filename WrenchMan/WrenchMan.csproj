<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Discord.Net" Version="3.20.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BepinexLogAnalysis\BepinexLogAnalysis.csproj"/>
    </ItemGroup>
    
    <ItemGroup>
        <None
                Include="$(SolutionDir)BepinexLogAnalysis/Jobs/ScoringJob/Configuration/*.json"
                Visible="false"
                CopyToOutputDirectory="PreserveNewest"
                CopyToPublishDirectory="PreserveNewest"
                Link="config/scoring_job_matchers/%(Filename)%(Extension)"
        />
    </ItemGroup>
</Project>
